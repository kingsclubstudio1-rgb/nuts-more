# Copy to .env.local and fill in. Restart the dev server after changes.

# --- Admin (store owner) ---
# The shared /login page routes THESE credentials to the admin panel.
ADMIN_EMAIL=admin@nutsandmore.store
ADMIN_PASSWORD=nutsandmore2019
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Supabase (customer accounts, purchase history, live data) ---
# URL is already known; you only need the two keys from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://zpfsjaqcmihdgpydddqp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-secret-key

# --- Razorpay (online checkout) ---
# Dashboard -> Settings -> API Keys. Use rzp_test_* keys while testing,
# switch to rzp_live_* only when you're ready to accept real payments.
# The secret must NEVER be prefixed with NEXT_PUBLIC_ or reach the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=paste-your-razorpay-key-secret
